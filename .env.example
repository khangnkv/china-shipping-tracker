# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the /admin/login page. Use a long, random value.
ADMIN_PASSWORD=

# From the LINE Developers Console > your Messaging API channel:
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional, but powers a lot: an OpenRouter (openrouter.ai) API key. Without
# it, the LINE bot still works via bilingual (Thai/English) keyword matching
# for common commands, but anything else gets a generic "didn't understand"
# menu instead of a real understanding of what the customer said. With it,
# also enables Chinese product title auto-translation and the admin "paste
# customer info" quick-fill.
OPENROUTER_API_KEY=
# Optional. OpenRouter model slug to use for the above. Defaults to a cheap
# multilingual-capable model if unset.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Public base URL of this app (no trailing slash), used to build the customer
# /track QR target, e.g. https://yourdomain.com. Falls back to the request host.
PUBLIC_BASE_URL=

# Optional LINE Official Account id, e.g. @yourshop. If set, the public /track
# page shows a "Contact shop on LINE" button. Leave blank to hide it.
LINE_CONTACT=

# development enables Flask debug/reload and allows non-HTTPS cookies for
# local testing. Leave unset (or "production") everywhere else.
FLASK_ENV=production

PORT=5000
